  "cards": [
    {
      "dot": "emerald",
      "title": "Archive",
      "items": [
        "snapshots.status is pending, done or failed",
        "archive_results.content holds inline data or a storage reference to a file",
        "job_queue carries the lease: heartbeat_at, lease_token, attempts"
      ]
    },
    {
      "dot": "cyan",
      "title": "Search",
      "items": [
        "SQLite indexes into the FTS5 table snapshots_fts, keyed by rowid = snapshots.id",
        "PostgreSQL and MySQL use search_index instead; search_vector exists on PostgreSQL only"
      ]
    },
    {
      "dot": "slate",
      "title": "Types",
      "items": [
        "SQLite column types shown; PostgreSQL and MySQL use BIGINT ids and VARCHAR where they need an index",
        "Timestamps are UTC text on every engine"
      ]
    }
  ]
