  "cards": [
    {
      "dot": "cyan",
      "title": "Clients",
      "items": [
        "The UI and SDK reach the server only over REST",
        "The CLI calls @webfrost/core in its own process: add runs the pipeline inline, import and schedule worker start their own JobRunner"
      ]
    },
    {
      "dot": "emerald",
      "title": "One process",
      "items": [
        "The server embeds the job runner, scheduler and recovery sweep",
        "WEBFROST_SCHEDULER=false leaves schedules to a separate worker"
      ]
    },
    {
      "dot": "amber",
      "title": "Data",
      "items": [
        "The API and pipeline read and write the database; files go to the storage backend",
        "Any database works with either storage backend"
      ]
    }
