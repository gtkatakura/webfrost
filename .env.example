# WebFrost server environment variables
# Copy this file to .env and fill in values. Never commit .env to version control.
# Full reference: apps/docs/content/docs/reference/configuration.mdx

# HTTP port the server listens on (default: 3000)
PORT=3000

# Directory for the SQLite database and snapshot archive files (default: ~/.webfrost)
# Not needed with Docker: the image and docker-compose.prod.yml already set /data and mount a volume.
# WEBFROST_DIR=/data

# Session secret — required for auth (must be at least 32 random characters).
# Generate one with: openssl rand -hex 32
SESSION_SECRET=

# Disable auth entirely (dev/testing only — never use in production).
# AUTH_DISABLED=true

# ─── Networking ─────────────────────────────────────────────────────────────
# Set to true only behind a reverse proxy that sets X-Forwarded-For. Without it the
# header is ignored and rate limits are keyed on the TCP peer address.
# WEBFROST_TRUST_PROXY=true

# Let anonymous visitors browse the archive read-only. Writes, schedules, imports,
# settings and API keys still require signing in.
# WEBFROST_PUBLIC_READ=true

# Session cookies are marked Secure, which browsers drop on plain-HTTP origins other
# than localhost. Set to true only for an HTTP-only deployment (e.g. a LAN address).
# WEBFROST_INSECURE_COOKIES=true

# Allow archiving loopback / private / link-local addresses (intranet archiving).
# Leave unset when users you do not fully trust can submit URLs.
# WEBFROST_ALLOW_PRIVATE_URLS=true

# ─── Pipeline ───────────────────────────────────────────────────────────────
# Archive pipelines run in parallel; each launches a headless Chromium (default: 3)
# WEBFROST_CONCURRENCY=3

# Minimum gap between two archives of the same host, in ms (default: 1000, 0 disables)
# WEBFROST_DOMAIN_DELAY_MS=1000

# Timeouts in ms: page fetch (30000), each extractor (60000), each yt-dlp run (600000)
# WEBFROST_FETCH_TIMEOUT_MS=30000
# WEBFROST_EXTRACTOR_TIMEOUT_MS=60000
# WEBFROST_MEDIA_TIMEOUT_MS=600000

# Use an existing Chromium/Chrome binary instead of the one Playwright downloads.
# WEBFROST_CHROMIUM_PATH=/usr/bin/chromium

# The server runs due schedules itself. Set to false if a separate
# `webfrost schedule worker` process should be the only one doing it.
# WEBFROST_SCHEDULER=false

# Time zone used to evaluate cron expressions (default: the system time zone, UTC in Docker)
# TZ=America/Sao_Paulo

# Log verbosity: debug | info | warn | error (default: info)
# WEBFROST_LOG_LEVEL=info

# ─── Storage backend ────────────────────────────────────────────────────────
# Storage backend: "filesystem" (default) or "s3"
# WEBFROST_STORAGE_BACKEND=filesystem

# S3-compatible object storage — required when WEBFROST_STORAGE_BACKEND=s3.
# Compatible with AWS S3, MinIO, Cloudflare R2, and Backblaze B2.
#
# Local dev with MinIO (see docker-compose.dev.yml):
#   S3_ENDPOINT=http://localhost:9000
#   S3_BUCKET=webfrost
#   S3_ACCESS_KEY_ID=minioadmin
#   S3_SECRET_ACCESS_KEY=minioadmin
#
# S3_ENDPOINT=https://s3.amazonaws.com
# S3_BUCKET=my-webfrost-bucket
# S3_ACCESS_KEY_ID=AKIAIOSFODNN7EXAMPLE
# S3_SECRET_ACCESS_KEY=wJalrXUtnFEMI/K7MDENG/bPxRfiCYEXAMPLEKEY
# S3_REGION=us-east-1
# S3_PATH_PREFIX=snapshots
