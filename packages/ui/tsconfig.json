{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "jsx": "react-jsx",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["bun-types", "vite/client"],
    "noEmit": true,
    // The docs site uses React 19; pin every import of React's types to this package's React 18
    // types, or libraries like react-router-dom pick up the other copy and JSX stops type-checking.
    "paths": {
      "react": ["./node_modules/@types/react"],
      "react/*": ["./node_modules/@types/react/*"],
      "react-dom": ["./node_modules/@types/react-dom"],
      "react-dom/*": ["./node_modules/@types/react-dom/*"],
      "@webfrost/sdk": ["../sdk/src/index.ts"]
    }
  },
  "include": ["src/**/*.ts", "src/**/*.tsx", "e2e/**/*.ts", "*.config.ts"],
  "exclude": ["node_modules", "dist"]
}
