{
  "name": "webfrost",
  "private": true,
  "version": "0.0.0",
  "workspaces": ["packages/*"],
  "scripts": {
    "webfrost": "bun run packages/cli/src/index.ts",
    "build": "bun run --filter '*' build",
    "test": "bun run --filter '*' test",
    "bench": "bun run --filter '*' benchmarks && bun bench/page-load.ts && bun bench/fetch-cache.bench.ts && bun bench/playwright-navigation.bench.ts && bun bench/cli-add.bench.ts",
    "lint": "biome check .",
    "format": "biome format --write .",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "prepare": "lefthook install",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "changeset tag"
  },
  "devDependencies": {
    "@biomejs/biome": "1.9.4",
    "@changesets/cli": "2.30.0",
    "bun-types": "1.3.11",
    "lefthook": "2.1.4",
    "mitata": "1.0.34",
    "playwright": "1.59.1",
    "typescript": "5.9.3"
  }
}
