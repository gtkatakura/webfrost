{
  "name": "webfrost",
  "private": true,
  "version": "0.0.0",
  "workspaces": ["packages/*"],
  "scripts": {
    "webfrost": "bun run packages/cli/src/index.ts",
    "build": "bun run --filter '*' build",
    "test": "bun run --filter '*' test",
    "bench": "bun run --filter '*' benchmarks && bun bench/page-load.ts && bun bench/fetch-cache.bench.ts && bun bench/playwright-navigation.bench.ts && bun bench/cli-add.bench.ts",
    "lint": "biome check .",
    "format": "biome format --write .",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "prepare": "lefthook install",
    "docs:dev": "vitepress dev docs --port 5174",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "changeset tag"
  },
  "devDependencies": {
    "@biomejs/biome": "1.9.4",
    "@changesets/cli": "2.30.0",
    "bun-types": "1.3.11",
    "lefthook": "2.1.4",
    "@braintree/sanitize-url": "^7.1.2",
    "cytoscape": "^3.33.1",
    "cytoscape-cose-bilkent": "^4.1.0",
    "dayjs": "^1.11.20",
    "debug": "^4.4.3",
    "mermaid": "^11.14.0",
    "mitata": "1.0.34",
    "playwright": "1.59.1",
    "typescript": "5.9.3",
    "vitepress": "^1.6.4",
    "vitepress-plugin-mermaid": "^2.0.17"
  }
}
